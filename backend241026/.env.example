NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Cantidad exacta de proxies inversos confiables. 0 para ejecución directa.
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foto_ya
DB_USER=foto_ya
DB_PASSWORD=
# Máximo por proceso; reservar margen para otros procesos y despliegues de Render.
DB_CONNECTION_LIMIT=2
DB_IDLE_TIMEOUT_MS=10000
# Para bases remotas, activar TLS y proporcionar el certificado CA.
DB_SSL_CA_PATH=
# Solo para convertir datos personales cifrados de versiones antiguas durante db:migrate.
# Check-in y la ejecución normal no utilizan esta clave.
# DATA_ENCRYPTION_KEY=
SESSION_HOURS=8
# Hostname Auth0 y IDs permitidos (Native y SPA separados por coma).
# AUTH0_DOMAIN=tu-tenant.auth0.com
# AUTH0_CLIENT_IDS=client-id-native,client-id-web
# Mailtrap Email Sandbox: siempre sandbox, nunca envío de producción.
# MAIL_API_KEY=
# MAIL_INBOX_ID=
# SENDER=verificacion@example.com
SUPABASE_URL=https://mjurenohqcxirsotdkrd.supabase.co
# URL del proyecto; NO el endpoint S3 (*.storage.supabase.co/storage/v1/s3).
# Clave secreta de servidor sb_secret_... (o service_role legacy). Nunca usar en frontend.
# Obtenerla en Settings > API Keys; NO usar Access key ID ni Secret access key de S3.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=Fotos
# Carga: JPG, PNG y WebP, hasta 6 MB; archivos privados con cliente opcional.
PHOTO_URL_SECONDS=60
STORAGE_TIMEOUT_MS=15000
