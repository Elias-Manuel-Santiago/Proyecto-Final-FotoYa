{
  "name": "backend",
  "version": "1.0.0",
  "description": "API de Foto Ya: MySQL y Supabase Storage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --import ./tests/setup.js --test tests/*.test.js",
    "test:integration": "node --import ./tests/setup.js --experimental-test-module-mocks --test tests/integration/*.test.js",
    "db:init": "node scripts/migrate.js --init",
    "db:migrate": "node scripts/migrate.js",
    "owner:create": "node scripts/create-owner.js",
    "photos:reconcile": "node scripts/reconcile-photos.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "2.118.0",
    "axios": "1.20.0",
    "cors": "^2.8.6",
    "dotenv": "18.0.8",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "^6.2.13",
    "mailtrap": "^5.0.0",
    "multer": "2.4.0",
    "mysql2": "^3.24.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
