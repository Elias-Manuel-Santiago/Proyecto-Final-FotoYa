NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Cantidad exacta de proxies inversos confiables. 0 para ejecución directa.
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foto_ya
DB_USER=foto_ya
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Para bases remotas, activar TLS y proporcionar el certificado CA.
DB_SSL_CA_PATH=
# Generar DOS claves distintas: node --input-type=module -e "import{randomBytes}from'node:crypto';console.log(randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
LOOKUP_HASH_KEY=
SESSION_HOURS=8
SUPABASE_URL=https://mjurenohqcxirsotdkrd.supabase.co
# Clave secreta de servidor sb_secret_... (o service_role legacy). Nunca usar en frontend.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=Fotos
# Carga: JPG, PNG y WebP, hasta 6 MB; archivos privados con cliente opcional.
PHOTO_URL_SECONDS=60
STORAGE_TIMEOUT_MS=15000
