{
  "expo": {
    "name": "Foto Ya",
    "slug": "foto-ya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/main-icon.jpg",
    "scheme": "fotoya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fotoya.app",
      "icon": "./assets/images/main-icon.jpg"
    },
    "android": {
      "package": "com.fotoya.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/main-icon.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/main-icon.jpg"
    },
    "plugins": [
      "./plugins/with-android-cmake",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Foto Ya necesita acceder a tus fotos para cargarlas al puesto.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
